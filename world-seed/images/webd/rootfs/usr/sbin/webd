#!/usr/bin/env node
// webd: a small static web server. /var/www (config "root") over HTTP on :80 and, as soon as a
// certificate for the first domain exists under /etc/ssl/uacme (webd-cert gets it), HTTPS on
// :443; then plain HTTP redirects there, except ACME challenges.   node webd /etc/webd.json
const fs = require('fs');
const http = require('http');
const https = require('https');
const path = require('path');

let cfg = JSON.parse(fs.readFileSync(process.argv[2] || '/etc/webd.json', 'utf8'));
let root = path.resolve(cfg.root || '/var/www');
let first = (cfg.domains || [])[0];
let certFile = cfg.cert || `/etc/ssl/uacme/${first}/cert.pem`;
let keyFile = cfg.key || `/etc/ssl/uacme/private/${first}/key.pem`;
let log = (...a) => console.log(new Date().toISOString(), ...a);
let TYPES = { '.html': 'text/html; charset=utf-8', '.css': 'text/css', '.js': 'text/javascript', '.json': 'application/json', '.svg': 'image/svg+xml', '.png': 'image/png', '.jpg': 'image/jpeg', '.txt': 'text/plain; charset=utf-8', '.ico': 'image/x-icon' };
let secure = false;

function serve(req, res) {
  let urlPath = decodeURIComponent(req.url.split('?')[0]);
  let file = path.resolve(root, '.' + urlPath);
  if (!file.startsWith(root)) {
    res.writeHead(403);
    return res.end('Forbidden\n');
  }
  try {
    if (fs.statSync(file).isDirectory()) file = path.join(file, 'index.html');
    let data = fs.readFileSync(file);
    res.writeHead(200, { 'Content-Type': TYPES[path.extname(file)] || 'application/octet-stream', 'Content-Length': data.length, Server: 'webd' });
    res.end(req.method === 'HEAD' ? undefined : data);
  } catch {
    res.writeHead(404, { 'Content-Type': 'text/html; charset=utf-8', Server: 'webd' });
    res.end('<!doctype html><title>Not Found</title><h1>Not Found</h1><p>The requested URL was not found on this server.</p>\n');
  }
  log(req.socket.remoteAddress, req.method, req.url);
}

http
  .createServer((req, res) => {
    let challenge = req.url.startsWith('/.well-known/acme-challenge/');
    if (secure && cfg.redirectToHttps && !challenge) {
      let host = String(req.headers.host || first).replace(/:\d+$/, '');
      res.writeHead(301, { Location: `https://${host}${req.url}`, Server: 'webd' });
      return res.end();
    }
    serve(req, res);
  })
  .listen(80, () => log('webd: http :80, root', root));

function tryHttps() {
  if (secure || !fs.existsSync(certFile) || !fs.existsSync(keyFile)) return;
  secure = true;
  https.createServer({ cert: fs.readFileSync(certFile), key: fs.readFileSync(keyFile) }, serve).listen(443, () => log('webd: https :443 for', (cfg.domains || []).join(' ')));
}
tryHttps();
let poll = setInterval(() => {
  tryHttps();
  if (secure) clearInterval(poll);
}, 5000);
