#!/usr/bin/env node
// acmed: a small ACME server (RFC 8555) for TrustRoot. Accounts and orders, JWS (ES256/384,
// RS256) checked with WebCrypto, http-01 challenges fetched over the network, certificates
// signed by the R1 issuer with the box's own `openssl`. State: <state>/accounts.json.
//   node /usr/sbin/acmed /etc/acmed.json
const fs = require('fs');
const http = require('http');
const https = require('https');
const { execFile } = require('child_process');

let cfg = JSON.parse(fs.readFileSync(process.argv[2] || '/etc/acmed.json', 'utf8'));
let BASE = cfg.base.replace(/\/$/, '');
let subtle = globalThis.crypto.subtle;
let log = (...a) => console.log(new Date().toISOString(), ...a);

let b64u = (buf) => Buffer.from(buf).toString('base64').replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
let unb64u = (s) => Buffer.from(String(s).replace(/-/g, '+').replace(/_/g, '/'), 'base64');
let rid = (n = 12) => b64u(globalThis.crypto.getRandomValues(new Uint8Array(n)));
let iso = (ms) => new Date(ms).toISOString();

/* ---------- state ---------- */

let accounts = {}; // id → { jwk, thumb, contact, status }
try {
  accounts = JSON.parse(fs.readFileSync(cfg.state + '/accounts.json', 'utf8'));
} catch {}
let saveAccounts = () => {
  try {
    fs.mkdirSync(cfg.state, { recursive: true });
    fs.writeFileSync(cfg.state + '/accounts.json', JSON.stringify(accounts, null, 1));
  } catch (err) {
    log('save accounts:', err.message);
  }
};
let orders = {}; // id → order (+ acct, certId)
let authzs = {}; // id → { acct, identifier, status, expires, challenges: [...] }
let certs = {}; // id → PEM chain
let nonces = new Set();
let newNonce = () => {
  let n = rid(16);
  nonces.add(n);
  if (nonces.size > 5000) nonces.delete(nonces.values().next().value);
  return n;
};

/* ---------- JWS ---------- */

class Problem extends Error {
  constructor(type, detail, status = 400) {
    super(detail);
    this.type = 'urn:ietf:params:acme:error:' + type;
    this.status = status;
  }
}

/** RFC 7638 thumbprint of a JWK. */
async function thumbprint(jwk) {
  let canon = jwk.kty === 'EC' ? { crv: jwk.crv, kty: 'EC', x: jwk.x, y: jwk.y } : { e: jwk.e, kty: 'RSA', n: jwk.n };
  return b64u(await subtle.digest('SHA-256', new TextEncoder().encode(JSON.stringify(canon))));
}

let ALGS = {
  ES256: { name: 'ECDSA', namedCurve: 'P-256', hash: 'SHA-256' },
  ES384: { name: 'ECDSA', namedCurve: 'P-384', hash: 'SHA-384' },
  RS256: { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' },
};

async function verifyJws(body, url) {
  let jws;
  try {
    jws = JSON.parse(body);
  } catch {
    throw new Problem('malformed', 'request body is not JSON');
  }
  let prot = JSON.parse(unb64u(jws.protected || '').toString() || '{}');
  if (!nonces.delete(prot.nonce)) throw new Problem('badNonce', 'invalid or reused nonce');
  if (prot.url !== url) throw new Problem('unauthorized', `JWS url ${prot.url} is not ${url}`, 401);
  let alg = ALGS[prot.alg];
  if (!alg) throw new Problem('badSignatureAlgorithm', `unsupported alg ${prot.alg}`);
  let jwk = prot.jwk;
  let acct = null;
  if (prot.kid) {
    let id = String(prot.kid).split('/acct/')[1];
    acct = accounts[id] && { id, ...accounts[id] };
    if (!acct) throw new Problem('accountDoesNotExist', 'unknown account', 400);
    if (acct.status !== 'valid') throw new Problem('unauthorized', 'account ' + acct.status, 401);
    jwk = acct.jwk;
  }
  if (!jwk) throw new Problem('malformed', 'JWS needs jwk or kid');
  let key = await subtle.importKey('jwk', jwk, alg.namedCurve ? { name: alg.name, namedCurve: alg.namedCurve } : { name: alg.name, hash: alg.hash }, false, ['verify']);
  let ok = await subtle.verify(alg.namedCurve ? { name: alg.name, hash: alg.hash } : alg.name, key, unb64u(jws.signature), new TextEncoder().encode(jws.protected + '.' + (jws.payload || '')));
  if (!ok) throw new Problem('unauthorized', 'bad JWS signature', 401);
  let payload = jws.payload ? JSON.parse(unb64u(jws.payload).toString()) : null; // '' = POST-as-GET
  return { prot, jwk, acct, payload };
}

/* ---------- openssl ---------- */

let run = (args, input) =>
  new Promise((resolve, reject) => {
    execFile('openssl', args, (err, stdout, stderr) => (err ? reject(new Error(String(stderr || err.message).trim().split('\n').pop())) : resolve(stdout)));
  });

async function issue(order, csrDer) {
  let dir = `${cfg.state}/tmp-${rid(6)}`;
  fs.mkdirSync(dir, { recursive: true });
  try {
    fs.writeFileSync(dir + '/csr.der', csrDer);
    await run(['req', '-inform', 'DER', '-in', dir + '/csr.der', '-out', dir + '/csr.pem']);
    // The CSR must only name what the order validated.
    let text = await run(['req', '-in', dir + '/csr.pem', '-noout', '-text']);
    let names = new Set(order.identifiers.map((i) => i.value.toLowerCase()));
    let san = (/DNS:[^\n]+/.exec(text) || [''])[0].split(',').map((s) => s.trim().replace(/^DNS:/, '').toLowerCase()).filter(Boolean);
    let cn = (/Subject:.*CN ?= ?([^,\n]+)/.exec(text) || [])[1]?.trim().toLowerCase();
    for (let n of [...san, ...(cn ? [cn] : [])]) if (!names.has(n)) throw new Problem('badCSR', `CSR names ${n}, which this order didn't validate`);
    let list = [...names];
    fs.writeFileSync(dir + '/ext.cnf', `basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth,clientAuth\nsubjectKeyIdentifier=hash\nauthorityKeyIdentifier=keyid\nsubjectAltName=${list.map((n) => 'DNS:' + n).join(',')}\n`);
    await run(['x509', '-req', '-in', dir + '/csr.pem', '-CA', cfg.issuer, '-CAkey', cfg.issuerKey, '-set_serial', '0x' + Buffer.from(globalThis.crypto.getRandomValues(new Uint8Array(12))).toString('hex'), '-days', String(cfg.days || 90), '-extfile', dir + '/ext.cnf', '-subj', '/CN=' + list[0], '-out', dir + '/cert.pem']);
    return fs.readFileSync(dir + '/cert.pem', 'utf8').trim() + '\n' + fs.readFileSync(cfg.issuer, 'utf8').trim() + '\n';
  } finally {
    fs.rmSync(dir, { recursive: true, force: true });
  }
}

/* ---------- http-01 ---------- */

function fetchText(url, ms = 8000) {
  return new Promise((resolve, reject) => {
    let req = http.get(url, (res) => {
      let data = '';
      res.setEncoding('utf8');
      res.on('data', (c) => (data += c).length > 4096 && req.destroy());
      res.on('end', () => (res.statusCode === 200 ? resolve(data) : reject(new Error(`HTTP ${res.statusCode}`))));
    });
    req.on('error', reject);
    req.setTimeout(ms, () => req.destroy(new Error('timed out')));
  });
}

async function validate(authz, chal) {
  let acct = accounts[authz.acct];
  let want = chal.token + '.' + acct.thumb;
  let url = `http://${authz.identifier.value}/.well-known/acme-challenge/${chal.token}`;
  try {
    let got = (await fetchText(url)).trim();
    if (got !== want) throw new Error(`the response at ${url} doesn't match the key authorization`);
    chal.status = 'valid';
    chal.validated = iso(Date.now());
    authz.status = 'valid';
    log('validated', authz.identifier.value, 'for account', authz.acct);
  } catch (err) {
    chal.status = 'invalid';
    chal.error = { type: 'urn:ietf:params:acme:error:connection', detail: `${url}: ${err.message}` };
    authz.status = 'invalid';
    log('validation failed', authz.identifier.value, err.message);
  }
  for (let o of Object.values(orders)) if (o.authzIds.includes(authz.id)) updateOrder(o);
}

function updateOrder(o) {
  if (o.status !== 'pending') return;
  let st = o.authzIds.map((id) => authzs[id].status);
  if (st.some((s) => s === 'invalid')) o.status = 'invalid';
  else if (st.every((s) => s === 'valid')) o.status = 'ready';
}

let orderJson = (o) => ({
  status: o.status,
  expires: o.expires,
  identifiers: o.identifiers,
  authorizations: o.authzIds.map((id) => `${BASE}/authz/${id}`),
  finalize: `${BASE}/finalize/${o.id}`,
  ...(o.certId ? { certificate: `${BASE}/cert/${o.certId}` } : {}),
});
let authzJson = (a) => ({
  identifier: a.identifier,
  status: a.status,
  expires: a.expires,
  challenges: a.challenges.map((c) => ({ type: c.type, url: `${BASE}/chall/${c.id}`, token: c.token, status: c.status, ...(c.validated ? { validated: c.validated } : {}), ...(c.error ? { error: c.error } : {}) })),
});

/* ---------- routes ---------- */

let directory = () => ({
  newNonce: `${BASE}/new-nonce`,
  newAccount: `${BASE}/new-acct`,
  newOrder: `${BASE}/new-order`,
  revokeCert: `${BASE}/revoke-cert`,
  keyChange: `${BASE}/key-change`,
  meta: { termsOfService: cfg.tos, website: 'http://trustroot.net/', caaIdentities: ['trustroot.net'] },
});

async function handlePost(path, url, body, res) {
  let { jwk, acct, payload } = await verifyJws(body, url);
  let reply = (status, obj, headers = {}) => send(res, status, obj, headers);

  if (path === '/new-acct') {
    let thumb = await thumbprint(jwk);
    let found = Object.entries(accounts).find(([, a]) => a.thumb === thumb);
    if (found) return reply(200, { status: found[1].status, contact: found[1].contact, orders: `${BASE}/acct/${found[0]}/orders` }, { Location: `${BASE}/acct/${found[0]}` });
    if (payload?.onlyReturnExisting) throw new Problem('accountDoesNotExist', 'no account for this key');
    if (!payload?.termsOfServiceAgreed) throw new Problem('userActionRequired', 'agree to the terms of service: ' + cfg.tos, 403);
    let id = rid(8);
    accounts[id] = { jwk, thumb, contact: payload.contact || [], status: 'valid', created: iso(Date.now()) };
    saveAccounts();
    log('new account', id, (payload.contact || []).join(' '));
    return reply(201, { status: 'valid', contact: accounts[id].contact, orders: `${BASE}/acct/${id}/orders` }, { Location: `${BASE}/acct/${id}` });
  }
  if (!acct) throw new Problem('malformed', 'use the account URL (kid)');
  if (path.startsWith('/acct/')) {
    if (payload?.status === 'deactivated') {
      accounts[acct.id].status = 'deactivated';
      saveAccounts();
    } else if (payload?.contact) {
      accounts[acct.id].contact = payload.contact;
      saveAccounts();
    }
    let a = accounts[acct.id];
    return reply(200, { status: a.status, contact: a.contact, orders: `${BASE}/acct/${acct.id}/orders` });
  }
  if (path === '/new-order') {
    let ids = payload?.identifiers || [];
    if (!ids.length) throw new Problem('malformed', 'no identifiers');
    for (let i of ids) {
      if (i.type !== 'dns' || !/^(?!-)[a-z0-9-]+(\.[a-z0-9-]+)+$/i.test(i.value || '')) throw new Problem('rejectedIdentifier', `can't issue for ${i.type}:${i.value}`);
      if (i.value.startsWith('*.')) throw new Problem('rejectedIdentifier', 'wildcards need dns-01, which TrustRoot does not offer');
    }
    let exp = Date.now() + 7 * 86400e3;
    let authzIds = ids.map((i) => {
      let id = rid(8);
      authzs[id] = { id, acct: acct.id, identifier: { type: 'dns', value: i.value.toLowerCase() }, status: 'pending', expires: iso(exp), challenges: [{ id: rid(8), type: 'http-01', token: rid(32), status: 'pending' }] };
      return id;
    });
    let id = rid(8);
    orders[id] = { id, acct: acct.id, status: 'pending', expires: iso(exp), identifiers: ids.map((i) => ({ type: 'dns', value: i.value.toLowerCase() })), authzIds };
    return reply(201, orderJson(orders[id]), { Location: `${BASE}/order/${id}` });
  }
  let [, kind, id] = path.split('/');
  if (kind === 'order' && orders[id]?.acct === acct.id) return reply(200, orderJson(orders[id]));
  if (kind === 'authz' && authzs[id]?.acct === acct.id) return reply(200, authzJson(authzs[id]));
  if (kind === 'chall') {
    let a = Object.values(authzs).find((x) => x.acct === acct.id && x.challenges.some((c) => c.id === id));
    if (!a) throw new Problem('malformed', 'no such challenge', 404);
    let c = a.challenges.find((x) => x.id === id);
    if (payload && c.status === 'pending') {
      c.status = 'processing';
      setTimeout(() => validate(a, c), 300);
    }
    return send(res, 200, { type: c.type, url: `${BASE}/chall/${c.id}`, token: c.token, status: c.status }, { Link: `<${BASE}/authz/${a.id}>;rel="up"` });
  }
  if (kind === 'finalize' && orders[id]?.acct === acct.id) {
    let o = orders[id];
    if (o.status !== 'ready') throw new Problem('orderNotReady', `order is ${o.status}`, 403);
    o.status = 'processing';
    try {
      let pem = await issue(o, unb64u(payload?.csr || ''));
      o.certId = rid(10);
      certs[o.certId] = pem;
      o.status = 'valid';
      log('issued', o.identifiers.map((i) => i.value).join(','), 'for account', acct.id);
    } catch (err) {
      o.status = 'invalid';
      throw err instanceof Problem ? err : new Problem('badCSR', err.message);
    }
    return reply(200, orderJson(o), { Location: `${BASE}/order/${id}` });
  }
  if (kind === 'cert' && certs[id]) {
    res.writeHead(200, { 'Content-Type': 'application/pem-certificate-chain', 'Replay-Nonce': newNonce() });
    return res.end(certs[id]);
  }
  if (path === '/revoke-cert' || path === '/key-change') throw new Problem('malformed', 'not supported by this CA', 501);
  throw new Problem('malformed', 'not found', 404);
}

function send(res, status, obj, headers = {}) {
  res.writeHead(status, { 'Content-Type': 'application/json', 'Replay-Nonce': newNonce(), 'Cache-Control': 'no-store', Link: `<${BASE}/directory>;rel="index"`, ...headers });
  res.end(JSON.stringify(obj, null, 1));
}

function handler(req, res) {
    let path = req.url.split('?')[0];
    let body = '';
    req.setEncoding('utf8');
    req.on('data', (c) => (body += c));
    req.on('end', async () => {
      try {
        if (path === '/directory' || path === '/') return send(res, 200, directory());
        if (path === '/new-nonce') {
          res.writeHead(req.method === 'HEAD' ? 200 : 204, { 'Replay-Nonce': newNonce(), 'Cache-Control': 'no-store' });
          return res.end();
        }
        if (path === '/terms') {
          res.writeHead(200, { 'Content-Type': 'text/plain' });
          return res.end('TrustRoot Subscriber Agreement: only request certificates for names you control.\n');
        }
        if (path === '/r1.pem') {
          res.writeHead(200, { 'Content-Type': 'application/x-pem-file' });
          return res.end(fs.readFileSync(cfg.issuer, 'utf8'));
        }
        if (req.method !== 'POST') throw new Problem('malformed', 'use POST (or POST-as-GET)', 405);
        if (!/^application\/jose\+json/.test(req.headers['content-type'] || '')) throw new Problem('malformed', 'Content-Type must be application/jose+json', 415);
        await handlePost(path, BASE + path, body, res);
      } catch (err) {
        let p = err instanceof Problem ? err : new Problem('serverInternal', err.message, 500);
        if (!(err instanceof Problem)) log('error', path, err.stack || err.message);
        res.writeHead(p.status, { 'Content-Type': 'application/problem+json', 'Replay-Nonce': newNonce() });
        res.end(JSON.stringify({ type: p.type, detail: p.message, status: p.status }));
      }
    });
}

// HTTPS is the directory (RFC 8555 requires it); port 80 answers too, for curious humans.
http.createServer(handler).listen(cfg.listen || 80, () => log(`acmed: http :${cfg.listen || 80}`));
if (cfg.cert && fs.existsSync(cfg.cert)) {
  https
    .createServer({ cert: fs.readFileSync(cfg.cert), key: fs.readFileSync(cfg.key) }, handler)
    .listen(cfg.httpsListen || 443, () => log(`acmed: ${BASE}/directory (issuer ${cfg.issuer})`));
} else log(`acmed: no TLS certificate at ${cfg.cert}: HTTPS is off`);
