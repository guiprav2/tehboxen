#!/bin/sh
# Stand-in for wasm-opt during port builds. clang runs whatever wasm-opt is on PATH after
# linking at -O levels; distro binaryen is often too old for exception handling / exnref
# (setjmp/longjmp) and fails to parse the output. Copy input to output unchanged.
in=""; out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -*) shift ;;
    *) in="$1"; shift ;;
  esac
done
[ -n "$in" ] && [ -n "$out" ] && [ "$in" != "$out" ] && cp "$in" "$out"
exit 0
