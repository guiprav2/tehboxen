+# if SEAMLESS_COMPRESSION && defined(__wasi__)
+/* Tehboxen: no vfork/pipes. The archive goes to a temporary file first, then
+ * "gzip -c tmp > FILE" (or to stdout) runs through system() at the end. */
+static const char *wasi_tar_out; /* -f name, NULL for stdout */
+static char wasi_tar_tmp[] = "/tmp/.tar-XXXXXX";
+static int wasi_tar_outfd = -1;
+
+static char *wasi_quote(const char *s)
+{
+	char *q = xzalloc(strlen(s) * 4 + 3), *o = q;
+	*o++ = '\'';
+	for (; *s; s++) {
+		if (*s == '\'') { strcpy(o, "'\\''"); o += 4; }
+		else *o++ = *s;
+	}
+	*o = '\'';
+	return q;
+}
+
+static void vfork_compressor(int tar_fd, const char *gzip UNUSED_PARAM)
+{
+	int tmp = mkstemp(wasi_tar_tmp);
+	if (tmp < 0)
+		bb_simple_perror_msg_and_die("can't create temporary file");
+	wasi_tar_outfd = dup(tar_fd);
+	xmove_fd(tmp, tar_fd);
+}
+
+static int wasi_compress_done(const char *gzip)
+{
+	char *tmpq = wasi_quote(wasi_tar_tmp);
+	char *cmd;
+	int st;
+	if (wasi_tar_out) {
+		char *outq = wasi_quote(wasi_tar_out);
+		close(wasi_tar_outfd); /* release the output file to the compressor */
+		cmd = xasprintf("%s -c %s > %s", gzip, tmpq, outq);
+		free(outq);
+	} else {
+		close(wasi_tar_outfd);
+		cmd = xasprintf("%s -c %s", gzip, tmpq);
+	}
+	st = system(cmd);
+	unlink(wasi_tar_tmp);
+	free(cmd);
+	free(tmpq);
+	return st;
+}
