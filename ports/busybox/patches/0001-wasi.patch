+#ifdef __wasi__
+#include <net/if.h>
+/* Tehboxen: no packet sockets. The kernel sends from 0.0.0.0 / to broadcasts on a
+ * UDP socket bound to the interface, which is all a DHCP exchange needs. */
+int FAST_FUNC udhcp_send_raw_packet(struct dhcp_packet *dhcp_pkt,
+		uint32_t source_nip, int source_port,
+		uint32_t dest_nip, int dest_port, const uint8_t *dest_arp UNUSED_PARAM,
+		int ifindex)
+{
+	char ifname[IF_NAMESIZE];
+	struct sockaddr_in sa;
+	unsigned padding;
+	int one = 1;
+	int result = -1;
+	int fd = socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP);
+	if (fd < 0) {
+		bb_simple_perror_msg("socket(UDP)");
+		return -1;
+	}
+	setsockopt_reuseaddr(fd);
+	setsockopt(fd, SOL_SOCKET, SO_BROADCAST, &one, sizeof(one));
+	if (if_indextoname(ifindex, ifname))
+		setsockopt_bindtodevice(fd, ifname);
+	memset(&sa, 0, sizeof(sa));
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons(source_port);
+	sa.sin_addr.s_addr = source_nip;
+	if (bind(fd, (struct sockaddr *)&sa, sizeof(sa)) < 0) {
+		bb_simple_perror_msg("bind(UDP)");
+		goto ret;
+	}
+	memset(&sa, 0, sizeof(sa));
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons(dest_port);
+	sa.sin_addr.s_addr = dest_nip;
+	padding = DHCP_OPTIONS_BUFSIZE - 1 - udhcp_end_option(dhcp_pkt->options);
+	if (padding > DHCP_SIZE - 300)
+		padding = DHCP_SIZE - 300;
+	udhcp_dump_packet(dhcp_pkt);
+	result = sendto(fd, dhcp_pkt, DHCP_SIZE - padding, 0, (struct sockaddr *)&sa, sizeof(sa));
+	if (result < 0)
+		bb_simple_perror_msg("sendto");
+ ret:
+	close(fd);
+	return result;
+}
+#else
 /* Construct a ip/udp header for a packet, send packet */
 int FAST_FUNC udhcp_send_raw_packet(struct dhcp_packet *dhcp_pkt,
 		uint32_t source_nip, int source_port,
@@ -190,6 +239,7 @@ int FAST_FUNC udhcp_send_raw_packet(struct dhcp_packet *dhcp_pkt,
 	}
 	return result;
 }
+#endif
 
