diff --git a/libdnet-stripped/src/route-linux.c b/libdnet-stripped/src/route-linux.c
index 4aaf90e..b825cac 100644
--- a/libdnet-stripped/src/route-linux.c
+++ b/libdnet-stripped/src/route-linux.c
@@ -1,3 +1,140 @@
+#ifdef __wasi__
+/*
+ * Tehboxen: no netlink or routing ioctls. Routes are read from the kernel's
+ * /proc/net/route; route_get() is a longest-prefix match over it. Changing
+ * routes goes through `ip route`, not libdnet.
+ */
+#include "config.h"
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "dnet.h"
+
+#define RTF_UP 0x0001
+
+struct route_handle {
+	int unused;
+};
+
+route_t *
+route_open(void)
+{
+	return calloc(1, sizeof(route_t));
+}
+
+int
+route_add(route_t *r, const struct route_entry *entry)
+{
+	(void)r; (void)entry;
+	errno = EPERM;
+	return (-1);
+}
+
+int
+route_add_dev(route_t *r, const struct route_entry *entry, const char *dev)
+{
+	(void)dev;
+	return route_add(r, entry);
+}
+
+int
+route_delete(route_t *r, const struct route_entry *entry)
+{
+	return route_add(r, entry);
+}
+
+int
+route_loop(route_t *r, route_handler callback, void *arg)
+{
+	FILE *fp;
+	struct route_entry entry;
+	char buf[BUFSIZ];
+	char ifbuf[16];
+	int ret = 0;
+	(void)r;
+
+	if ((fp = fopen("/proc/net/route", "r")) == NULL)
+		return (-1);
+	while (fgets(buf, sizeof(buf), fp) != NULL) {
+		int i, iflags, refcnt, use, metric, mss, win, irtt;
+		uint32_t mask;
+		memset(&entry, 0, sizeof(entry));
+		i = sscanf(buf, "%15s %X %X %X %d %d %d %X %d %d %d\n",
+		    ifbuf, &entry.route_dst.addr_ip,
+		    &entry.route_gw.addr_ip, &iflags, &refcnt, &use,
+		    &metric, &mask, &mss, &win, &irtt);
+		if (i < 11 || !(iflags & RTF_UP))
+			continue;
+		strlcpy(entry.intf_name, ifbuf, sizeof(entry.intf_name));
+		entry.route_dst.addr_type = entry.route_gw.addr_type = ADDR_TYPE_IP;
+		if (addr_mtob(&mask, IP_ADDR_LEN, &entry.route_dst.addr_bits) < 0)
+			continue;
+		entry.route_gw.addr_bits = IP_ADDR_BITS;
+		entry.metric = metric;
+		if ((ret = callback(&entry, arg)) != 0)
+			break;
+	}
+	fclose(fp);
+	return (ret);
+}
+
+struct best_route {
+	uint32_t dst;
+	int bits;
+	struct route_entry found;
+};
+
+static int
+best_route_cb(const struct route_entry *e, void *arg)
+{
+	struct best_route *b = arg;
+	uint32_t mask;
+	if (e->route_dst.addr_type != ADDR_TYPE_IP)
+		return (0);
+	addr_btom(e->route_dst.addr_bits, &mask, IP_ADDR_LEN);
+	if ((b->dst & mask) != (e->route_dst.addr_ip & mask))
+		return (0);
+	if (e->route_dst.addr_bits > b->bits) {
+		b->bits = e->route_dst.addr_bits;
+		b->found = *e;
+	}
+	return (0);
+}
+
+int
+route_get(route_t *r, struct route_entry *entry)
+{
+	struct best_route b;
+	if (entry->route_dst.addr_type != ADDR_TYPE_IP) {
+		errno = EAFNOSUPPORT;
+		return (-1);
+	}
+	memset(&b, 0, sizeof(b));
+	b.dst = entry->route_dst.addr_ip;
+	b.bits = -1;
+	route_loop(r, best_route_cb, &b);
+	if (b.bits < 0) {
+		errno = ESRCH;
+		return (-1);
+	}
+	entry->route_gw = b.found.route_gw;
+	if (entry->route_gw.addr_ip == 0) /* on-link: the destination is the next hop */
+		entry->route_gw = entry->route_dst;
+	entry->route_gw.addr_bits = IP_ADDR_BITS;
+	strlcpy(entry->intf_name, b.found.intf_name, sizeof(entry->intf_name));
+	entry->metric = b.found.metric;
+	return (0);
+}
+
+route_t *
+route_close(route_t *r)
+{
+	free(r);
+	return (NULL);
+}
+#else
 /*
  * route-linux.c
  *
@@ -401,3 +538,4 @@ route_close(route_t *r)
 	}
 	return (NULL);
 }
+#endif /* __wasi__ */
