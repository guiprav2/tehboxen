   struct in6_addr mask;
 
diff --git a/libpcap/pcap-null.c b/libpcap/pcap-null.c
index f0e35ec..d9bffc2 100644
--- a/libpcap/pcap-null.c
+++ b/libpcap/pcap-null.c
@@ -25,6 +25,245 @@
 
 #include "pcap-int.h"
 
+
+#ifdef __wasi__
+/*
+ * Tehboxen: live capture on the box's simulated interfaces. The kernel's AF_PACKET
+ * sockets hand over every frame in or out of an interface (Ethernet framing, real
+ * MACs); filters run here in userland (pcapint_filter), injection is a send().
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <netpacket/packet.h>
+#include <arpa/inet.h>
+
+struct pcap_tehboxen {
+	int ifindex;
+	u_int packets_received;
+	u_int packets_dropped;
+};
+
+static int
+tb_read(pcap_t *p, int cnt, pcap_handler callback, u_char *user)
+{
+	struct pcap_tehboxen *pt = p->priv;
+	int n = 0;
+	for (;;) {
+		if (p->break_loop) {
+			p->break_loop = 0;
+			return (PCAP_ERROR_BREAK);
+		}
+		if (n > 0 && (cnt <= 0 || n >= cnt) && !PACKET_COUNT_IS_UNLIMITED(cnt))
+			return (n);
+		/* Wait for a frame: the timeout (or immediately, non-blocking). */
+		struct pollfd pfd = { p->fd, POLLIN, 0 };
+		int wait = p->opt.nonblock ? 0 : (p->opt.timeout > 0 ? p->opt.timeout : -1);
+		if (n > 0)
+			wait = 0;
+		int r = poll(&pfd, 1, wait);
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			pcapint_fmt_errmsg_for_errno(p->errbuf, PCAP_ERRBUF_SIZE, errno, "poll");
+			return (PCAP_ERROR);
+		}
+		if (r == 0)
+			return (n);
+		struct sockaddr_ll from;
+		socklen_t fl = sizeof(from);
+		ssize_t len = recvfrom(p->fd, p->buffer, p->bufsize, 0, (struct sockaddr *)&from, &fl);
+		if (len < 0) {
+			if (errno == EAGAIN || errno == EINTR)
+				return (n);
+			pcapint_fmt_errmsg_for_errno(p->errbuf, PCAP_ERRBUF_SIZE, errno, "recvfrom");
+			return (PCAP_ERROR);
+		}
+		if (p->direction == PCAP_D_IN && from.sll_pkttype == PACKET_OUTGOING)
+			continue;
+		if (p->direction == PCAP_D_OUT && from.sll_pkttype != PACKET_OUTGOING)
+			continue;
+		pt->packets_received++;
+		u_int caplen = (u_int)len > (u_int)p->snapshot ? (u_int)p->snapshot : (u_int)len;
+		if (p->fcode.bf_insns && !pcapint_filter(p->fcode.bf_insns, p->fcode.bf_len, p->buffer, (u_int)len, caplen))
+			continue;
+		struct pcap_pkthdr h;
+		gettimeofday(&h.ts, NULL);
+		h.caplen = caplen;
+		h.len = (u_int)len;
+		callback(user, &h, p->buffer);
+		n++;
+		if (!PACKET_COUNT_IS_UNLIMITED(cnt) && n >= cnt)
+			return (n);
+	}
+}
+
+static int
+tb_inject(pcap_t *p, const void *buf, int size)
+{
+	ssize_t r = send(p->fd, buf, (size_t)size, 0);
+	if (r < 0) {
+		pcapint_fmt_errmsg_for_errno(p->errbuf, PCAP_ERRBUF_SIZE, errno, "send");
+		return (PCAP_ERROR);
+	}
+	return ((int)r);
+}
+
+static int
+tb_stats(pcap_t *p, struct pcap_stat *ps)
+{
+	struct pcap_tehboxen *pt = p->priv;
+	ps->ps_recv = pt->packets_received;
+	ps->ps_drop = pt->packets_dropped;
+	ps->ps_ifdrop = 0;
+	return (0);
+}
+
+static int
+tb_setdirection(pcap_t *p, pcap_direction_t d)
+{
+	p->direction = d;
+	return (0);
+}
+
+static void
+tb_cleanup(pcap_t *p)
+{
+	pcapint_cleanup_live_common(p);
+}
+
+static int
+tb_activate(pcap_t *p)
+{
+	struct pcap_tehboxen *pt = p->priv;
+	const char *dev = p->opt.device;
+	int any = !dev || !strcmp(dev, "any");
+	pt->ifindex = any ? 0 : (int)if_nametoindex(dev);
+	if (!any && !pt->ifindex) {
+		snprintf(p->errbuf, PCAP_ERRBUF_SIZE, "%s: No such device exists", dev);
+		return (PCAP_ERROR_NO_SUCH_DEVICE);
+	}
+	p->fd = socket(AF_PACKET, SOCK_RAW, htons(0x0003 /* ETH_P_ALL */));
+	if (p->fd < 0) {
+		if (errno == EPERM || errno == EACCES) {
+			snprintf(p->errbuf, PCAP_ERRBUF_SIZE, "%s: You don't have permission to perform this capture on that device (socket: Operation not permitted)", dev ? dev : "any");
+			return (PCAP_ERROR_PERM_DENIED);
+		}
+		pcapint_fmt_errmsg_for_errno(p->errbuf, PCAP_ERRBUF_SIZE, errno, "socket");
+		return (PCAP_ERROR);
+	}
+	if (!any) {
+		struct sockaddr_ll ll;
+		memset(&ll, 0, sizeof(ll));
+		ll.sll_family = AF_PACKET;
+		ll.sll_protocol = htons(0x0003);
+		ll.sll_ifindex = pt->ifindex;
+		if (bind(p->fd, (struct sockaddr *)&ll, sizeof(ll)) < 0) {
+			pcapint_fmt_errmsg_for_errno(p->errbuf, PCAP_ERRBUF_SIZE, errno, "bind");
+			close(p->fd);
+			return (PCAP_ERROR);
+		}
+	}
+	if (p->snapshot <= 0 || p->snapshot > MAXIMUM_SNAPLEN)
+		p->snapshot = MAXIMUM_SNAPLEN;
+	p->linktype = DLT_EN10MB;
+	p->bufsize = 65536 + 64;
+	p->buffer = malloc(p->bufsize);
+	if (!p->buffer) {
+		pcapint_fmt_errmsg_for_errno(p->errbuf, PCAP_ERRBUF_SIZE, errno, "malloc");
+		close(p->fd);
+		return (PCAP_ERROR);
+	}
+	if (p->opt.nonblock)
+		fcntl(p->fd, F_SETFL, fcntl(p->fd, F_GETFL) | O_NONBLOCK);
+	p->selectable_fd = p->fd;
+	p->read_op = tb_read;
+	p->inject_op = tb_inject;
+	p->setfilter_op = pcapint_install_bpf_program;
+	p->setdirection_op = tb_setdirection;
+	p->set_datalink_op = NULL;
+	p->getnonblock_op = pcapint_getnonblock_fd;
+	p->setnonblock_op = pcapint_setnonblock_fd;
+	p->stats_op = tb_stats;
+	p->cleanup_op = tb_cleanup;
+	return (0);
+}
+
+pcap_t *
+pcapint_create_interface(const char *device _U_, char *ebuf)
+{
+	pcap_t *p = PCAP_CREATE_COMMON(ebuf, struct pcap_tehboxen);
+	if (p == NULL)
+		return (NULL);
+	p->activate_op = tb_activate;
+	return (p);
+}
+
+static int
+tb_if_flags(const char *name _U_, bpf_u_int32 *flags, char *errbuf _U_)
+{
+	*flags |= PCAP_IF_CONNECTION_STATUS_CONNECTED;
+	return (0);
+}
+
+int
+pcapint_platform_finddevs(pcap_if_list_t *devlistp, char *errbuf)
+{
+	struct if_nameindex *list = if_nameindex();
+	int s = socket(AF_INET, SOCK_DGRAM, 0);
+	if (!list)
+		return (0);
+	for (struct if_nameindex *i = list; i->if_index; i++) {
+		struct ifreq r;
+		bpf_u_int32 flags = 0;
+		memset(&r, 0, sizeof(r));
+		strncpy(r.ifr_name, i->if_name, IFNAMSIZ - 1);
+		if (ioctl(s, SIOCGIFFLAGS, &r) == 0) {
+			if (r.ifr_flags & IFF_UP)
+				flags |= PCAP_IF_UP;
+			if (r.ifr_flags & IFF_RUNNING)
+				flags |= PCAP_IF_RUNNING;
+			if (r.ifr_flags & IFF_LOOPBACK)
+				flags |= PCAP_IF_LOOPBACK;
+		}
+		pcap_if_t *d = pcapint_find_or_add_dev(devlistp, i->if_name, flags, tb_if_flags, NULL, errbuf);
+		if (!d)
+			continue;
+		struct ifreq ra, rm, rb;
+		memcpy(&ra, &r, sizeof r);
+		memcpy(&rm, &r, sizeof r);
+		memcpy(&rb, &r, sizeof r);
+		if (ioctl(s, SIOCGIFADDR, &ra) == 0) {
+			int hm = ioctl(s, SIOCGIFNETMASK, &rm) == 0;
+			int hb = ioctl(s, SIOCGIFBRDADDR, &rb) == 0 && !(flags & PCAP_IF_LOOPBACK);
+			pcapint_add_addr_to_dev(d, &ra.ifr_addr, sizeof(struct sockaddr_in),
+			    hm ? &rm.ifr_netmask : NULL, hm ? sizeof(struct sockaddr_in) : 0,
+			    hb ? &rb.ifr_broadaddr : NULL, hb ? sizeof(struct sockaddr_in) : 0,
+			    NULL, 0, errbuf);
+		}
+	}
+	if_freenameindex(list);
+	if (s >= 0)
+		close(s);
+	if (pcap_add_any_dev(devlistp, errbuf) == NULL)
+		return (-1);
+	return (0);
+}
+
+const char *
+pcap_lib_version(void)
+{
+	return (PCAP_VERSION_STRING " (Tehboxen AF_PACKET)");
+}
+#else
 static char nosup[] = "live packet capture not supported on this system";
 
 pcap_t *
@@ -61,3 +300,4 @@ pcap_lib_version(void)
 {
 	return (PCAP_VERSION_STRING);
 }
+#endif /* __wasi__ */
