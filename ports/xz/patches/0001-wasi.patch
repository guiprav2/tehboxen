diff --git a/src/xz/file_io.c b/src/xz/file_io.c
index 6f784dd..3805923 100644
--- a/src/xz/file_io.c
+++ b/src/xz/file_io.c
@@ -141,13 +141,20 @@ io_init(void)
 	// we are root.
 	warn_fchown = geteuid() == 0;
 
+#ifdef __wasi__
+	// Tehboxen: no pipe(); signals are only delivered inside blocking
+	// syscalls, so poll() on the data fd alone sees user_abort promptly.
+	user_abort_pipe[0] = user_abort_pipe[1] = -1;
+	if (0)
+#else
 	// Create a pipe for the self-pipe trick.
 	if (pipe(user_abort_pipe))
+#endif
 		message_fatal(_("Error creating a pipe: %s"),
 				strerror(errno));
 
 	// Make both ends of the pipe non-blocking.
